TELEGRAM_BOT_TOKEN=123456789:replace_with_botfather_token
TELEGRAM_CHAT_ID=123456789
URL=https://prague.pasport.org.ua/solutions/e-queue
NOTIFY_COOLDOWN_SECONDS=1800
REQUEST_TIMEOUT_SECONDS=20
BROWSER_WAIT_SECONDS=5
USER_AGENT=Mozilla/5.0 (compatible; PassportServicePragueMonitor/1.0; +https://prague.pasport.org.ua/solutions/e-queue)

# Optional persistent state storage.
# Recommended for Railway/Render because cron jobs may not keep local files.
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@host:5432/database

# SQLite example:
# DATABASE_URL=sqlite:///state.db

# Local JSON fallback when DATABASE_URL is empty:
# STATE_FILE=state.json

# Optional for GitHub Actions only:
# STATE_BACKEND=github_contents
# GITHUB_STATE_PATH=.monitor-state/state.json
# Legacy GitHub Actions variable backend:
# GITHUB_STATE_VARIABLE=PASSPORT_SERVICE_PRAGUE_STATE
